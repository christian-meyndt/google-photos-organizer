# Google OAuth credentials (download from Google Cloud Console)
GOOGLE_CLIENT_SECRETS_FILE=credentials.json

# Where to store organized photos
OUTPUT_DIR=/Users/christianmeyndt/Pictures/Organized

# Ollama model for vision classification
OLLAMA_MODEL=llama3.2-vision
OLLAMA_BASE_URL=http://localhost:11434

# Minimum file size to process (bytes) - skip thumbnails
MIN_FILE_SIZE_BYTES=500000

# Quality thresholds
MIN_RESOLUTION_WIDTH=640
MIN_RESOLUTION_HEIGHT=480
BLUR_THRESHOLD=100.0

# Perceptual hash distance threshold for duplicates (lower = stricter)
HASH_DISTANCE_THRESHOLD=8

# Google accounts to process (comma-separated labels)
ACCOUNTS=christian,wife
